# Virtual environment
.venv/

# Python bytecode
__pycache__/

# Account Activity output files
Account_Activity_WBC.csv
Account_Activity_WBC.txt
Account_Activity_WBC_backup.csv
Account_Activity_WBC_backup.txt

# Generated MyAgent tools-inventory report (regenerated on demand)
MyAgent_Tools_Report.txt

# IDE settings
.vscode/

# Runtime state files
agent_state*.json
app_state*.json
# Authored-content stores — live in <OneDrive>/MyAppShare/ (synced across machines
# by OneDrive, not git; see myagent/datapaths.py). These repo-root names are the
# no-OneDrive fallback; a leftover repo-root copy is auto-unioned into the
# shared store on first launch and renamed *.migrated.bak (covered by *.bak)
agent_instructions.json
skills.json
system_prompts.json
# TodoList data — lives in <OneDrive>/MyAppShare/todos.json (synced across
# machines by OneDrive, not git); these repo-root copies are the no-OneDrive
# fallback / pre-migration leftovers. State (geometry/filters) is per-machine.
todos.json
todo_state.json
# legacy CSVEditor state location — migrated to ~/.config/csveditor/ on first
# run; kept ignored so stale copies on other machines stay invisible
csv_editor_state.json

# Native TodoList build artifact (arm64 Mach-O, per-machine — rebuild with
# ./build_todolist_native.sh; the source TodoList.mm IS tracked)
TodoList.exe

# Lock files
selfbot.lock
agent_lock_*.lock

# SelfBot runtime IPC files (cross-instance message passing; created/deleted at runtime)
selfbot_auto_msg.json
selfbot_inject.txt

# Error logs
launch_err.txt

# API cost log (per-run, per-machine — appended by MyAgent after each run)
APICostLog.txt*

# Saved email output from summary runs (per-machine runtime output)
*.eml

# Heartbeat per-pass log + rotated archives (repo-root fallback on Windows; macOS logs to ~/Library/Logs)
heartbeat.log*

# UnreadSummary per-pass log (repo-root fallback on Windows; macOS logs to ~/Library/Logs)
unread_summary.log*

# Claude Code config
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/rules/

# macOS Finder metadata
.DS_Store

# MCP server config — per-user, may contain commands or env-stored tokens
mcp_servers.json

# Vendored MCP server packages (installed locally so we can patch them
# without npx cache volatility — paths are absolute and per-machine)
.mcp-deps/

# Saved chat conversations — local-only, never committed
saved_chats/

# Local scratch files at repo root (not part of the project)
FROM.txt
MyAgent_preview.png
hello_world_gui.py
*.txtLaptop

# Stray scratch from misdirected shell redirects (e.g. Windows-style `>nul`
# evaluated in bash creates a literal file named `nul`)
nul
# Empty TextEdit / RTF scratch
Untitled.*
# Generic backup files (e.g. agent_instructions.json.bak)
*.bak

# Git Bash crash dumps
*.stackdump

SpecifyingList.csv
# UnreadSummary matched-bill PDFs — repo-root fallback location on a
# OneDrive-less machine (normally <OneDrive>/MyImportant/DeathFinances/Attachments)
/Attachments/

# Sun2Set almanac output — PRIVACY: these files embed a street address in the
# filename plus 6-decimal (~10 cm) latitude/longitude and a site-specific
# horizon profile in the header. This repo is PUBLIC and git history is
# permanent, so they must never be committed.
Sun2Set_*.txt
